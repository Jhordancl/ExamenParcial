@model IEnumerable<PlataformaIncidencias.Models.Incidencia>

@{
    ViewData["Title"] = "Incidencias Abiertas";
}

<div class="container mt-4">
    <h1>Incidencias abiertas</h1>
    <p class="text-muted">Listado de averías activas en estaciones de bicicletas compartidas.</p>

    @if (!Model.Any())
    {
        <div class="alert alert-success">
            <i class="bi bi-check-circle"></i> No hay incidencias abiertas en este momento.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover" id="tabla-incidencias">
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>Estación</th>
                        <th>Descripción</th>
                        <th>Prioridad</th>
                        <th>Fecha</th>
                        <th>Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr id="fila-@item.Id">
                            <td>@item.Id</td>
                            <td>@item.Estacion</td>
                            <td>@item.Descripcion</td>
                            <td>
                                @{
                                    var badgeClass = item.Prioridad switch
                                    {
                                        "Alta" => "danger",
                                        "Media" => "warning",
                                        _ => "secondary"
                                    };
                                }
                                <span class="badge bg-@badgeClass">@item.Prioridad</span>
                            </td>
                            <td>@item.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <form asp-controller="Operaciones" asp-action="Cerrar" asp-route-id="@item.Id" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                            onclick="return confirm('¿Cerrar incidencia #@item.Id?')">
                                        <i class="bi bi-x-circle"></i> Cerrar
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
