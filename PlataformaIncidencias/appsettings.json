{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=incidencias.db"
  },
  "Algolia": {
    "AppId": "YOUR_ALGOLIA_APP_ID",
    "AdminKey": "YOUR_ALGOLIA_ADMIN_KEY",
    "SearchKey": "YOUR_ALGOLIA_SEARCH_KEY",
    "IndexName": "incidencias"
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "PieHost": {
    "ChannelUrl": "YOUR_PIEHOST_CHANNEL_URL",
    "ChannelKey": "YOUR_PIEHOST_CHANNEL_KEY"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
